---
import '../styles/2026/theme.css'

interface Props {
	title: string
	backlink?: boolean
}

const { title, backlink = true } = Astro.props
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title} | TurtleCon 2026</title>
	</head>
	<body class="tc2026">
		<header>
			{backlink && <a class="backlink" href="/2026">TurtleCon 2026</a>}
			<div class="header-row">
				<slot name="heading" />
				<slot name="toc" />
			</div>
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>
