---
import Layout from '../../layouts/Layout2026.astro'

interface Day {
	day: number
	date: string
	label: string
	main: string
	dessert: string
}

const days: Day[] = [
	{
		day: 1,
		date: '2026-11-05',
		label: 'November 5, 2026',
		main: 'Lemongrass chicken peanut satay rice bowls',
		dessert: 'Horchata pudding with sautéed cinnamon-maple apples',
	},
	{
		day: 2,
		date: '2026-11-06',
		label: 'November 6, 2026',
		main: 'Butter chicken & channa saag with spiced basmati rice & naan',
		dessert: 'Mango lime ginger sorbet',
	},
	{
		day: 3,
		date: '2026-11-07',
		label: 'November 7, 2026',
		main: 'DIY pork shoulder and glazed mushroom baos',
		dessert: 'Pineapple lychee mint sorbet',
	},
	{
		day: 4,
		date: '2026-11-08',
		label: 'November 8, 2026',
		main: 'Lemongrass shiitake congee + leftover bonanza',
		dessert: 'Cut persimmons & asian pears w/ honey lime',
	},
]
---

<Layout title="Food">
	<h1>Food</h1>

	{
		days.map(({ day, date, label, main, dessert }) => (
			<section>
				<h2>
					Day {day} <time datetime={date}>{label}</time>
				</h2>

				<p>
					{main}
				</p>
				<p>
					{dessert}
				</p>
			</section>
		))
	}

	<a href="/2026">Back</a>
</Layout>
