---
import Layout from '../../layouts/Layout2026.astro'

interface Drink {
	name: string
	location?: string
	abv?: number | number[]
}

interface Section {
	title: string
	drinks: Drink[]
}

const sections: Section[] = [
	{
		title: 'Beer',
		drinks: [
			{ name: 'Middlebrow "Yard Work" Kölsch', location: 'Chicago, IL', abv: 4 },
			{ name: 'Middlebrow "Oak Forest No.2" Flanders Red', location: 'Chicago, IL', abv: 4 },
			{ name: 'Warsteiner Pilsner', location: 'Warstein, Germany', abv: 4.8 },
			{ name: 'Old Irving "Shoto" Japanese Rice Lager', location: 'Chicago, IL', abv: 4.8 },
			{ name: 'Haymarket "Speakerswagon" Pils', location: 'Chicago, IL', abv: 5 },
			{ name: 'Oxbow "Wilde Moon" Farmhouse Ale w/ Elderflower + Honey', location: 'Newcastle, ME', abv: 5 },
			{ name: 'Two Brothers "Prairie Path" Golden Ale', location: 'Warrenville, IL', abv: 5.1 },
			{ name: 'Art History "Good Morning Munich" Helles Lager', location: 'Geneva, IL', abv: 5.2 },
			{ name: 'Lexington Brewing Vanilla Barrel Cream Ale', location: 'Lexington, KY', abv: 5.5 },
			{ name: 'Third Space Brewing Oktoberfest', location: 'Milwaukee, WI', abv: 6 },
			{ name: 'Badger State Brewing "Pumpkin Buzzy" Coffee Ale', location: 'Green Bay, WI', abv: 6 },
			{ name: 'Maine Beer Co. "Mean Old Tom" Aged Stout', location: 'Freeport, ME', abv: 6.5 },
			{ name: 'Art History "Major" Northeast IPA', location: 'Geneva, IL', abv: 6.6 },
			{ name: 'Innis & Gunn Malt Cask Scottish Golden Beer', location: 'Edinburgh, Scotland', abv: 6.6 },
			{ name: 'Trappist Rochefort Flight (6, 8, Tripel Extra)', location: 'Rochefort, Belgium', abv: [7.5, 9.2, 8.1] },
			{ name: 'Oxbow "Liquid Swords" Barrel-Aged Farmhouse Ale', location: 'Newcastle, ME', abv: 8 },
			{ name: 'Unibroue "Brassin d\'Exception" Belgian Stout', location: 'Chambly, Québec', abv: 10 },
			{ name: 'St. Bernardus ABT 12', location: 'Watou, Belgium', abv: 10 },
		],
	},
	{
		title: 'Cider',
		drinks: [
			{ name: 'Ace "Perry"', location: 'Sebastopol, CA', abv: 5 },
			{ name: 'Shacksbury "Classic" Dry Cider', location: 'Vergennes, VT', abv: 5.2 },
			{ name: 'Haykin Family Calville Blanc d\'Hiver', location: 'Aurora, CO', abv: 5.9 },
			{ name: 'Eris "Chaos Series: Raspberry Fields"', location: 'Chicago, IL', abv: 6 },
			{ name: 'Shacksbury "Sweater Weather"', location: 'Vergennes, VT', abv: 8 },
			{ name: 'Etienne Dupont Cidre Triple', location: 'Victot-Pontfol, France', abv: 8.5 },
		],
	},
	{
		title: 'Non-alcoholic',
		drinks: [
			{ name: 'Fresca' },
			{ name: 'Waterloo' },
			{ name: 'OFK Rice Milk' },
			{ name: 'Mars × Joong Boo Soda (Ube, Pandan, Matcha, Yuzu)' },
			{ name: 'Oi Ocha Golden Oolong' },
			{ name: 'Oi Ocha Yuzu Green Tea' },
			{ name: 'Oi Ocha Bold Green Tea' },
			{ name: 'Woongjin Roasted Corn Tea' },
			{ name: 'Woongjin Barley Drink' },
			{ name: 'NamDoNongSan Bitter Melon Tea' },
			{ name: 'Gruvi Bubbly Rosé NA' },
			{ name: 'Botanic Baladin NA Malt' },
		],
	},
	{
		title: 'Coffee + Tea',
		drinks: [
			{ name: 'Metric Crimson Decaf Cold Brew' },
			{ name: 'Backlot "Flying Squirrel" Cold Brew' },
			{ name: "Metropolis Xeno's Decaf" },
			{ name: 'Ffeine Mexican Cake' },
			{ name: 'Ffeine Teodoro Breakfast Blend' },
			{ name: 'Rare Tea Cellars Masala Chai Rooibos' },
			{ name: 'Taylors of Harrogate Assam Black Tea' },
			{ name: 'Café de olla (Café Bustelo, canela + piloncillo)' },
			{ name: 'Iced Chai Latte w/ Banana Cold Foam' },
		],
	},
]

const sortKey = (abv: Drink['abv']) => [abv].flat()[0] ?? 0

const slug = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, '-')

// Keep "+", "&" and "w/" attached to the word after them so they never end a line.
const glue = (name: string) => name.replace(/ ([+&]|w\/) /g, ' $1\u00a0')

for (const section of sections) {
	section.drinks.sort((a, b) => sortKey(a.abv) - sortKey(b.abv))
}
---

<Layout title="Drinks">
	<h1 slot="heading">Drinks</h1>
	<nav slot="toc" class="toc" aria-label="Jump to section">
		<ul>
			{
				sections.map(({ title }) => (
					<li>
						<a href={`#${slug(title)}`} data-sfx="cursor">{title}</a>
					</li>
				))
			}
		</ul>
	</nav>

	{
		sections.map(({ title, drinks }) => (
			<section id={slug(title)}>
				<h2>{title}</h2>
				<ul>
					{drinks.map(({ name, location, abv }) => (
						<li>
							<span class="name">{glue(name)}</span>
							{(location || abv !== undefined) && (
								<>
									<span class="sep" aria-hidden="true">{'\u00a0•'}</span>{' '}
									<span class="meta">
										{location && <span class="location">{location}</span>}
										{location && abv !== undefined && <span class="sep" aria-hidden="true"> • </span>}
										{abv !== undefined && <span class="abv">{[abv].flat().join('% / ')}%</span>}
									</span>
								</>
							)}
						</li>
					))}
				</ul>
			</section>
		))
	}
</Layout>
